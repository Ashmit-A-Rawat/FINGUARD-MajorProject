# Copy to .env and edit. Never commit .env.
APP_ENV=development
APP_NAME=fin-guard
LOG_LEVEL=INFO

# API auth. Required outside development: at least 32 random characters, e.g. `openssl rand -base64 48`.
API_SECRET_KEY=change-me
TOKEN_TTL_MINUTES=480
ENGINE_ENABLED=true
DATASET_DIR=./data/synthetic/small
CORS_ORIGINS=http://localhost:5173

# Database
# SQLite for development; PostgreSQL in production (see deployment architecture).
DATABASE_URL=sqlite:///./data/finguard.db
# DATABASE_URL=postgresql+psycopg://finguard:finguard@localhost:5432/finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard
POSTGRES_DB=finguard

# Data
DATA_DIR=./data
SYNTHETIC_SEED=42

# LLM (Phase 8). Provider: mock | qwen | mistral. No external commercial APIs.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_DEVICE=auto
# Never download model weights unless you set this deliberately (check `make hardware` first).
LLM_ALLOW_DOWNLOAD=false
